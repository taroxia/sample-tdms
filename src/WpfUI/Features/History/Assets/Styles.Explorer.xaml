<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="ExplorerBg" Color="#F8FAFC"/>
    <!-- カードスタイル＆バッジスタイル  -->
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#64748B"/>
    <SolidColorBrush x:Key="AccentColor" Color="#2563EB"/>
    <SolidColorBrush x:Key="PassColor" Color="#16A34A"/>
    <SolidColorBrush x:Key="FailColor" Color="#DC2626"/>

  <Style x:Key="ExplorerCardStyle" TargetType="Border">
    <Setter Property="Background" Value="#252526"/>
    <Setter Property="BorderBrush" Value="#3F3F46"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
</ResourceDictionary>